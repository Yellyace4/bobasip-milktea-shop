# ============================================================
# BobaSip environment variables (example only - NO real secrets)
# ============================================================
# STATIC FRONTEND (deployed to browser via Vercel static files)
# ------------------------------------------------------------
# This project is plain HTML/CSS/JS (no Vite/Next build-time env injection).
# Set the browser-safe Supabase URL + publishable/anon key in:
#   js/supabase-config.js  (loaded by all HTML pages; must be deployed)
# Use the values below as your reference. The anon key is public by design;
# access is enforced by Supabase Auth + Row Level Security (RLS).
# NEVER put SUPABASE_SERVICE_ROLE_KEY or any server secret in frontend code.
#
#   SUPABASE_URL=https://YOUR_PROJECT.supabase.co
#   SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
#
# SERVER-ONLY (configure in Vercel Project Settings > Environment Variables)
# ------------------------------------------------------------------------
# Used only by api/notify.js (Vercel serverless function). Never expose to the
# browser/frontend/HTML or any public config.
# ============================================================

# --- Supabase (server-side only, api/notify.js) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Notification providers (server-side only, api/notify.js) ---
# Email receipts via Resend: https://resend.com
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM=BobaSip <receipts@your-verified-domain.com>

# SMS alerts via Semaphore: https://semaphore.co
SEMAPHORE_API_KEY=YOUR_SEMAPHORE_API_KEY
SEMAPHORE_SENDER_NAME=BobaSip
